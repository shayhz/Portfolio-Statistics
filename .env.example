# Copy this file to .env and fill in your tastytrade OAuth credentials.
# .env is gitignored -- it is never committed.
#
# Create an OAuth application at:
#   https://my.tastytrade.com/app.html#/manage/api-access/oauth-applications
# Use a callback URL of http://localhost:8000 and tick only the read scopes --
# this app never places orders. Then use Manage > Create Grant to mint the
# refresh token, which does not expire.
#
# Treat the secret and refresh token like a password: together they are full
# access to the account.

TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=

# Optional: restrict to a single account number, or a comma-separated list.
# Leave blank to aggregate every open account.
TASTYTRADE_ACCOUNT=

# Optional: use the sandbox/certification environment instead of production.
TASTYTRADE_SANDBOX=false
